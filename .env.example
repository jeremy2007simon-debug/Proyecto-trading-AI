# =============================================================================
# Environment variables — copy to .env.local and fill in real values.
# NEVER commit .env.local, .env, or any file containing real secrets.
# =============================================================================

# --- Supabase --------------------------------------------------------------
# Project URL and anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key bypasses Row Level Security. Server-side only. NEVER
# prefix this with NEXT_PUBLIC_ and NEVER import it from client components.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application -------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=development

# --- Market Data (Alpaca Market Data API) -----------------------------------
# https://alpaca.markets — free account, Market Data API only, no funding or
# trading permissions required. See docs/ARCHITECTURE.md for the full
# provider comparison and setup steps.
MARKET_DATA_PROVIDER=alpaca
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# "sip" (full consolidated tape, default — reliable historical depth back to
# ~2016 on accounts with SIP access, needed for backtesting) or "iex" (free
# real-time-only feed; empirically inconsistent for SPY 5-minute bars before
# ~2020). Falls back to "sip" if unset or set to anything else.
ALPACA_FEED=sip

# Shared secret to authenticate POST /api/market-data/ingest. Generate a
# long random value, never reuse it.
MARKET_DATA_INGEST_SECRET=

# --- Block 6: RS3M_CANDIDATE_V1 PAPER trading (Alpaca Trading API) ---------
# PAPER-ONLY. src/core/execution/alpaca-paper-client.ts hardcodes Alpaca's
# PAPER base URL (https://paper-api.alpaca.markets/v2) as its only base-URL
# constant — no variable here or anywhere else can redirect it to a LIVE
# endpoint. Use the "Paper Trading" API keys from your Alpaca dashboard, NOT
# your live-account keys (a paper account's keys will not work against the
# live endpoint anyway, since this client never calls it). See
# docs/ARCHITECTURE.md §1 and docs/BLOCK6_CANDIDATE_VERIFICATION_REPORT.md.
ALPACA_PAPER_API_KEY_ID=
ALPACA_PAPER_API_SECRET_KEY=

# DRY_RUN=true (default, and the only value exercised so far) computes the
# full rebalance plan (signal, ranking, target portfolio, orders, estimated
# turnover/cost) WITHOUT calling any order-placing Alpaca endpoint — only
# read-only calls (getAccount/getPositions) are made. Setting it to "false"
# is a precondition for real order submission, gated further by
# PAPER_TRADING below; DRY_RUN=false alone does not submit anything.
DRY_RUN=true

# PAPER_TRADING=true is required (in addition to DRY_RUN=false) before
# scripts/block6/paper/run-rebalance.ts will submit a real (paper) order.
# Defaults to false. Never set to anything that would target a live account
# — there is no such setting; see the structural guard described above.
PAPER_TRADING=false

# =============================================================================
# Placeholders for future integrations. Not used by this delivery — no LIVE
# broker is connected and no real (non-paper) orders are placed in this
# version. See the Block 6 PAPER trading section above for the one narrow,
# audited exception.
# =============================================================================

# Shared secret to authenticate inbound TradingView webhook payloads at
# /api/webhooks/tradingview. Generate a long random value, never reuse it.
TRADINGVIEW_WEBHOOK_SECRET=

# Alerting channel(s) for the Notifications module.
ALERTS_TELEGRAM_BOT_TOKEN=
ALERTS_TELEGRAM_CHAT_ID=

# AI explanation layer provider key. The AI layer only ever explains
# decisions already made by the quantitative pipeline — see
# src/core/ai-layer/types.ts for its explicit capability boundary.
AI_EXPLANATION_PROVIDER_API_KEY=
